NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas (free M0) or a local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/basera

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Sign-in codes by email via Resend (https://resend.com, free 3,000 emails/month).
# Empty in development = the code is printed in the server terminal instead.
# Gmail: turn on 2-step verification, then make an App Password (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=Basera <onboarding@resend.dev>

APP_TIMEZONE=Asia/Kolkata
# Scheduled jobs (dues, reminders, 48h complaint check). true on exactly ONE server.
ENABLE_JOBS=false

# Invite links shared on WhatsApp: <INVITE_LINK_BASE>/<token>
INVITE_LINK_BASE=https://basera.app/i
INVITE_TTL_DAYS=14

# Cloudinary (photos, receipts, documents). Empty = upload endpoints return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase service account JSON (raw or base64). Empty = in-app inbox only, no phone popups.
FIREBASE_SERVICE_ACCOUNT=

# Request logs in the apiLogs collection, auto-deleted after N days
ENABLE_API_LOGS=true
API_LOG_TTL_DAYS=14

# Comma-separated list of allowed web origins. Leave empty for the mobile app only.
CORS_ORIGINS=
